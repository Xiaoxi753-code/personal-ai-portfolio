# 复制此文件为 .env.local 后，再填入你自己的真实值。
# 不要把 .env.local 提交到 GitHub、上传网盘、贴进聊天窗口或截图中。

# OpenAI 兼容 API 的密钥，例如 DeepSeek API Key。
AI_API_KEY=your_api_key_here

# OpenAI 兼容 API 的基础地址。DeepSeek 示例：
AI_BASE_URL=https://api.deepseek.com/v1

# 使用的模型名称。DeepSeek 示例：
AI_MODEL=deepseek-chat

# Supabase 项目地址，可在 Supabase 项目后台的 API 设置中找到。
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase 的浏览器客户端 Key（anon / publishable key）。
# 绝对不要在这里填写 service_role 或 secret key。
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 仅供 /api/chat 服务端读取知识库使用，具有绕过 RLS 的高权限。
# 不要添加 NEXT_PUBLIC_ 前缀，绝不可写在客户端代码、文档或 Git 提交里。
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
